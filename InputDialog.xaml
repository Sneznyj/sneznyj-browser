<Window x:Class="SneznyjBrowser.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="Height" Width="460" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Border Margin="20" CornerRadius="14" Background="{StaticResource PopupBrush}" BorderBrush="#2A3747" BorderThickness="1" Padding="20,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" LineHeight="19"/>
            <Border x:Name="InputBox" Margin="0,14,0,0" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Height="38"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Grid Margin="12,0">
                    <TextBlock x:Name="HintText" Foreground="{StaticResource MutedBrush}" FontSize="13.5" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="Input" Style="{StaticResource BareTextBox}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" Style="{StaticResource TextButton}" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="Готово" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
