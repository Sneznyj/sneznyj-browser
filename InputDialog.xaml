<Window x:Class="SneznyjBrowser.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="Height" Width="460" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Border Margin="20" CornerRadius="14" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
            BorderThickness="1" Padding="20,18" Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" Foreground="{DynamicResource SoftTextBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" LineHeight="19"/>
            <TextBlock x:Name="Label1" Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
            <Border x:Name="InputBox" Margin="0,14,0,0" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Height="38"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid Margin="12,0">
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource MutedBrush}" FontSize="13.5" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="Input" Style="{StaticResource BareTextBox}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock x:Name="Label2" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
            <TextBox x:Name="Input2" Style="{StaticResource FieldBox}" Margin="0,6,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" Style="{StaticResource TextButton}" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="Готово" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
