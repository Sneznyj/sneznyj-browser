<Window x:Class="SneznyjBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SneznyjBrowser"
        Title="Снежный браузер" Width="1360" Height="860" MinWidth="760" MinHeight="480"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Логотип -->
        <StackPanel x:Name="BrandPanel" Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="18,0,0,0">
            <Path x:Name="LogoPath" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/>
            <TextBlock Text="Снежный" Margin="10,0,0,0" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Верхняя панель: навигация, адрес, действия, кнопки окна -->
        <Grid x:Name="TopBar" Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Назад (Alt+←)" Click="Back_Click"/>
                <Button x:Name="ForwardBtn" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Вперёд (Alt+→)" Click="Forward_Click"/>
                <Button x:Name="ReloadBtn" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Обновить (F5)" Click="Reload_Click"/>
            </StackPanel>

            <Border x:Name="AddressBorder" Grid.Column="1" Height="34" CornerRadius="10" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="Transparent" BorderThickness="1"
                    WindowChrome.IsHitTestVisibleInChrome="True" Cursor="IBeam">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SecurityIcon" FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Background="Transparent" Cursor="Arrow"/>
                    <TextBlock x:Name="AddressPlaceholder" Grid.Column="1" Text="Поиск или адрес сайта"
                               Foreground="{StaticResource MutedBrush}" FontSize="13.5" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                    <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource BareTextBox}" VerticalAlignment="Center"
                             KeyDown="AddressBox_KeyDown" TextChanged="AddressBox_TextChanged"
                             GotKeyboardFocus="AddressBox_GotKeyboardFocus" LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                             PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"/>
                    <Border x:Name="PrivateBadge" Grid.Column="2" Visibility="Collapsed" Margin="0,0,6,0" Padding="8,2"
                            CornerRadius="6" Background="#2A2140" VerticalAlignment="Center">
                        <TextBlock Text="Приватная" Foreground="{StaticResource PrivateBrush}" FontSize="11.5"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                <Button x:Name="ShieldBtn" Style="{StaticResource IconButton}" Padding="9,0" Click="Shield_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ShieldIcon" Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShieldCount" Text="0" Margin="6,0,0,1" FontFamily="{StaticResource UiFont}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="Добавить на стартовую (Ctrl+D)" Click="AddToStart_Click"/>
                <Button x:Name="PanelBtn" Style="{StaticResource IconButton}" Content="&#xE90D;" ToolTip="Боковая панель (Ctrl+Shift+B)" Click="PanelToggle_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Поиск и команды (Ctrl+K)" Click="Palette_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Свернуть" Click="Min_Click"/>
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Развернуть" Click="Max_Click"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Закрыть" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Боковая колонка: пространства и вкладки -->
        <Grid x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Margin="10,2,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource WorkspaceButton}" ToolTip="Новое пространство"
                        Click="AddWorkspace_Click" VerticalAlignment="Top" Margin="0,0,0,4">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </Button>
                <ItemsControl x:Name="WorkspaceList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Workspace}">
                            <Button Style="{StaticResource WorkspaceButton}" Click="Workspace_Click" ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{Binding AccentBrush}"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Переименовать" Click="WsRename_Click"/>
                                        <MenuItem Header="Сменить значок и цвет" Click="WsLook_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить пространство" Click="WsDelete_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="4,8,4,6">
                <TextBlock x:Name="WsCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBlock x:Name="WsTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Button Grid.Row="2" Style="{StaticResource RowButton}" Click="NewTab_Click" ToolTip="Новая вкладка (Ctrl+T)" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Width="22"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <TextBlock Text="Новая вкладка" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <ListBox x:Name="TabList" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{StaticResource TabItemStyle}"
                     SelectionChanged="TabList_SelectionChanged" PreviewMouseDown="TabList_PreviewMouseDown"
                     PreviewMouseRightButtonUp="TabList_PreviewMouseRightButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:BrowserTab}">
                        <Grid Height="34" ToolTip="{Binding Title}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" HorizontalAlignment="Left" Margin="8,0,0,0">
                                <TextBlock x:Name="FallbackIcon" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="FavImage" Source="{Binding Favicon}" Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Path x:Name="Spinner" Visibility="Collapsed" Width="14" Height="14" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 7,1 A 6,6 0 1 1 1,7" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <Button x:Name="AudioBtn" Grid.Column="2" Style="{StaticResource TinyIconButton}" Content="&#xE767;"
                                    Visibility="Collapsed" ToolTip="Звук вкладки" Click="TabMute_Click"/>
                            <Button x:Name="CloseBtn" Grid.Column="3" Style="{StaticResource TinyIconButton}" Content="&#xE711;"
                                    Visibility="Hidden" ToolTip="Закрыть (Ctrl+W)" Click="TabClose_Click" Margin="0,0,4,0"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                <Setter TargetName="FallbackIcon" Property="Text" Value="&#xED1A;"/>
                                <Setter TargetName="FallbackIcon" Property="Foreground" Value="{StaticResource PrivateBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowAudio}" Value="True">
                                <Setter TargetName="AudioBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="AudioBtn" Property="Content" Value="&#xE74F;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FavImage" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Spinner"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4">
                <!-- Новая версия браузера -->
                <Border x:Name="UpdateCard" Visibility="Collapsed" Margin="0,6,0,0" Padding="12,10,12,12" CornerRadius="10"
                        Background="#16273A" BorderBrush="#2F5578" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UpdateHeading" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="UpdateNotes" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SoftTextBrush}"
                                   TextWrapping="Wrap" MaxHeight="64" TextTrimming="WordEllipsis" LineHeight="16"/>
                        <Grid x:Name="UpdateProgress" Visibility="Collapsed" Margin="0,10,0,0">
                            <Border x:Name="UpdateTrack" Height="4" CornerRadius="2" Background="#263A50" VerticalAlignment="Top"/>
                            <Border x:Name="UpdateFill" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="0"/>
                            <TextBlock x:Name="UpdateStatus" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="UpdateNowBtn" Content="Обновить" Style="{StaticResource AccentButton}" Height="28" Padding="14,0"
                                    Click="UpdateNow_Click"/>
                            <Button x:Name="UpdateLaterBtn" Content="Позже" Style="{StaticResource TextButton}" Height="28" Padding="12,0"
                                    Margin="6,0,0,0" Click="UpdateLater_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="Toast" Visibility="Collapsed" Margin="0,6,0,0" Padding="12,9" CornerRadius="10"
                        Background="#1D2B3B" BorderBrush="#2C4058" BorderThickness="1">
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12.5"/>
                </Border>
            </StackPanel>

            <Button Grid.Row="5" Style="{StaticResource RowButton}" Click="Palette_Click" Margin="0,6,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="5" Background="#1C2633" BorderBrush="#2A3747" BorderThickness="1" Padding="6,1">
                        <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Width="22"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <TextBlock Text="Поиск и команды" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
            </Button>
        </Grid>

        <!-- Страница и боковая панель -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="SplitterCol" Width="0"/>
                <ColumnDefinition x:Name="PanelCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="LoadBar" IsIndeterminate="True" Height="2" Visibility="Hidden"
                             Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
                <Border x:Name="PageBorder" Grid.Row="1" Background="{StaticResource PageBgBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid x:Name="PageHost"/>
                </Border>
            </Grid>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed" ResizeBehavior="PreviousAndNext"
                          DragCompleted="PanelSplitter_DragCompleted"/>

            <Grid x:Name="PanelRoot" Grid.Column="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                            ToolTip="Скрыть панель (Ctrl+Shift+B)" Click="PanelClose_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="12"
                            ToolTip="Открыть во вкладке" Click="PanelToTab_Click"/>
                    <ItemsControl x:Name="PanelAppList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PanelApp}">
                                <Button x:Name="AppBtn" Style="{StaticResource IconButton}" Padding="10,0" Margin="0,0,2,0"
                                        Click="PanelApp_Click" ToolTip="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AppName" Text="{Binding Name}" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                                   Margin="7,0,0,1" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="AppBtn" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                        <Setter TargetName="AppBtn" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter TargetName="AppName" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource PageBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid x:Name="PanelHost"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
